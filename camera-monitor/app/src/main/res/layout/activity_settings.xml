<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/settings_back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Imagem: lente e qualidade da transmissão -->
            <TextView
                style="@style/SettingsSection"
                android:layout_marginTop="8dp"
                android:text="@string/image_title" />

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/image_lens_label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/lensGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lensBack"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lens_back" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lensFront"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lens_front" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/image_quality_label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/qualityGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qualityLow"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quality_low" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qualityMedium"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quality_medium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qualityHigh"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quality_high" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/qualityHint"
                style="@style/SettingsHint" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />

            <!-- Detecção de movimento -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/motionSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/motion_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/sensitivityLabel"
                style="@style/SettingsLabel"
                android:text="@string/motion_sensitivity_label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/sensitivityGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sensitivityLow"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quality_low" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sensitivityMedium"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quality_medium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sensitivityHigh"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quality_high" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/motionHint"
                style="@style/SettingsHint" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />

            <!-- Proteção por PIN -->
            <TextView
                style="@style/SettingsSection"
                android:text="@string/protection_title" />

            <TextView
                android:id="@+id/protectionStatus"
                style="@style/SettingsHint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pinSetButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pin_set" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pinRemoveButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/pin_remove"
                    android:visibility="gone" />

            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />

            <!-- Servidor: endereço salvo no aparelho -->
            <TextView
                style="@style/SettingsSection"
                android:text="@string/server_title" />

            <TextView
                android:id="@+id/serverText"
                style="@style/SettingsHint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/serverButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/server_change" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />

            <!-- Conta -->
            <TextView
                style="@style/SettingsSection"
                android:text="@string/account_title" />

            <TextView
                android:id="@+id/accountText"
                style="@style/SettingsHint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signOutButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sign_out" />

            <TextView
                android:id="@+id/signOutHint"
                style="@style/SettingsHint"
                android:text="@string/sign_out_running_hint"
                android:visibility="gone" />

            <TextView
                android:id="@+id/versionText"
                style="@style/SettingsHint"
                android:layout_marginTop="32dp"
                android:gravity="center" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
