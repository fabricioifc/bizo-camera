<?xml version="1.0" encoding="utf-8"?>
<!-- Aba Ajustes: aparência, proteção por PIN, servidor, conta e atualização do app. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Aparência -->
        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="8dp"
            android:text="@string/appearance_title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/SectionCardContent">

                <TextView
                    style="@style/OptionLabel"
                    android:text="@string/theme_label" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/themeGroup"
                    style="@style/ChoiceGroup">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/themeSystem"
                        style="@style/ChoiceButton"
                        android:text="@string/theme_system" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/themeLight"
                        style="@style/ChoiceButton"
                        android:text="@string/theme_light" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/themeDark"
                        style="@style/ChoiceButton"
                        android:text="@string/theme_dark" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    style="@style/OptionHint"
                    android:text="@string/theme_hint" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Proteção por PIN -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/protection_title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/SectionCardContent">

                <TextView
                    android:id="@+id/protectionTitle"
                    style="@style/OptionLabel" />

                <TextView
                    android:id="@+id/protectionStatus"
                    style="@style/OptionHint"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pinSetButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pin_set" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pinRemoveButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/pin_remove"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Servidor -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/server_title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/OptionLabel"
                        android:text="@string/server_label" />

                    <TextView
                        android:id="@+id/serverText"
                        style="@style/OptionHint"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/serverButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/server_change" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Conta -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/account_title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/SectionCardContent">

                <TextView
                    style="@style/OptionLabel"
                    android:text="@string/account_label" />

                <TextView
                    android:id="@+id/accountText"
                    style="@style/OptionHint"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signOutButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/sign_out"
                    android:textColor="?attr/colorError" />

                <TextView
                    android:id="@+id/signOutHint"
                    style="@style/OptionHint"
                    android:text="@string/sign_out_running_hint"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Atualização pelo próprio app -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/update_title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/SectionCardContent">

                <TextView
                    android:id="@+id/updateInstalled"
                    style="@style/OptionLabel" />

                <TextView
                    android:id="@+id/updateStatus"
                    style="@style/OptionHint"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/updateProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/update_check_button" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
