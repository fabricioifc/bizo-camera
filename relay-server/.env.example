# Endereço público deste servidor, usado no login com Google e no cookie seguro.
# Troque pelo domínio próprio, incluindo https:// quando houver TLS.
PUBLIC_URL=

# Use 1 quando o servidor estiver atrás de um proxy ou túnel, como cloudflared.
TRUST_PROXY=1

# Exige verificação em duas etapas para acessar a conta e as câmeras.
REQUIRE_2FA=1

# O cadastro fica fechado após a criação da primeira conta.
# Defina 1 temporariamente para permitir outros cadastros.
ALLOW_SIGNUP=0

# Credenciais OAuth do Google; deixe vazias para desativar o login com Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcionais; vazias usam o padrão.
# Espaço total para os vídeos de movimento, em MB (padrão 500).
CLIP_STORAGE_MB=
# Tempo sem conexão até o alerta "Câmera offline", em milissegundos (padrão 300000 = 5 minutos).
OFFLINE_ALERT_MS=
# Pacote do app aceito na atualização pelo próprio app (padrão br.dev.bizo.cameramonitor).
APP_PACKAGE=

# Backup diário em UTC. "0 6 * * *" equivale a 03:00 em Brasília.
BACKUP_SCHEDULE=0 6 * * *
BACKUP_KEEP=14
# Pasta dos backups no servidor (padrão ./backups). No Dokploy, use uma pasta fixa.
# BACKUP_DIR=/home/fabricio/backups/relay-server
